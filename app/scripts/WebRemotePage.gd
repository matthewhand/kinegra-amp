extends Reference
const HTML = """<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kinegra Amp Remote</title>
<style>:root{color-scheme:dark;font:17px system-ui;background:#09111f;color:#edf7fb}body{max-width:64rem;margin:3vh auto;padding:1rem}h1{font-size:1.7rem;margin-bottom:.3rem}h2{font-size:1.25rem}section{background:#152538;border:1px solid #314c64;border-radius:1rem;padding:1.2rem;margin:1rem 0}input,button{font:inherit;padding:.8rem;border-radius:.65rem;border:1px solid #54718b;margin:.2rem 0}input{width:100%;box-sizing:border-box;background:#091724}button{background:#20394c;color:inherit;cursor:pointer;min-height:3rem}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible{outline:3px solid #4ee7c2}button.primary{background:#167964}button[aria-pressed=true]{border-color:#4ee7c2;background:#214e54}#controls,.row,.tabs{display:flex;gap:.6rem;flex-wrap:wrap}#controls button{flex:1 1 7rem}#track{font-size:1.4rem;overflow-wrap:anywhere}#connection{color:#4ee7c2}#message{padding:.9rem;border-radius:.6rem;background:#102b32;min-height:1.2em}#message.error,#pair-error:not(:empty){background:#4d2530;color:#ffdae1;border:1px solid #e5899b;padding:.9rem}#pair-error:empty{display:none}small,.muted{line-height:1.5;color:#acc0ce}article{padding:1rem 0;border-top:1px solid #314c64}article h3{margin:.25rem 0;font-size:1.1rem;overflow-wrap:anywhere}article p{margin:.3rem 0;color:#b7cdda;overflow-wrap:anywhere}#search-form{display:flex;gap:.6rem;margin:.7rem 0}#search-form input{flex:1;min-width:4rem}#columns{display:grid;grid-template-columns:3fr 2fr;gap:1rem}#columns section{margin:0}#queue-list{padding-left:1.4rem}#queue-list li{padding:.6rem 0;overflow-wrap:anywhere}[hidden]{display:none!important}@media(max-width:720px){#columns{grid-template-columns:1fr}body{padding:.6rem}section{padding:1rem}.tabs button{flex:1}#controls button{flex-basis:27%}}</style>
<h1>Kinegra Amp Remote <small>1.0.10</small></h1><small>Play and queue music in Kinegra Amp on your TV. Trusted local network only.</small><p id="connection" role="status">Not connected</p>
<section id="pair"><label for="key">Access key from Kinegra Amp → Settings → Web remote</label><input id="key" type="password" autocomplete="off" spellcheck="false" autocapitalize="off" placeholder="16-character access key"><button id="connect" class="primary">Connect</button><p id="pair-error" role="alert"></p><small>The key changes when Kinegra Amp restarts. If it is rejected, use the current key shown on the TV.</small></section>
<p id="message" role="status" aria-live="polite">Enter your access key and choose Connect.</p><noscript>JavaScript is needed for this remote. Enable it or use another browser.</noscript>
<section><div id="track">Connect to see playback</div><p id="state">No connection</p><div id="controls"><button class="primary" data-action="play" disabled>▶ Play</button><button data-action="pause" disabled>Ⅱ Pause</button><button data-action="previous" disabled>◀ Previous</button><button data-action="next" disabled>Next ▶</button><button data-action="stop" disabled>■ Stop</button><button id="disconnect" disabled>Disconnect</button></div></section>
<div id="columns" hidden><section><h2>Music Assistant library</h2><div class="tabs"><button data-kind="tracks">Tracks</button><button data-kind="albums">Albums</button><button data-kind="playlists">Playlists</button></div><form id="search-form"><input id="search" maxlength="100" placeholder="Search your library" aria-label="Search your library"><button type="submit">Search</button></form><p id="library-title" class="muted">Choose music</p><div class="row"><button id="collection-back" hidden>← Back to library</button><button id="queue-page" disabled>+ Queue Page</button><button id="view-queue">View Queue</button></div><div id="library-list"></div><div class="row"><button id="previous-page" disabled>← Previous page</button><button id="next-page" disabled>Next page →</button></div></section>
<section id="queue"><h2>Queue</h2><button id="refresh-queue">Refresh Queue</button><div class="row"><label id="offline-limit-label">Tracks to save <input id="offline-limit" type="number" min="1" max="8192" placeholder="Up to 8192"></label><button id="save-offline">Save Queue Offline</button><button id="play-offline" hidden>Play Saved Queue</button><button id="cancel-offline" hidden>Pause Saving</button><button id="discard-offline" hidden>Discard Pending Copy</button></div><p id="offline-message" class="muted"></p><details><summary>Set up local-file copying</summary><p>Run the included file-source helper on your music host. Only your local files are supported; subscription streams cannot be saved.</p><input id="source-origin" placeholder="http://192.168.1.30:8766" aria-label="Local-file source address"><input id="source-key" type="password" autocomplete="off" aria-label="File-source key" placeholder="File-source access key"><button id="save-source">Save Source</button></details><p id="queue-message" class="muted">Refresh to load upcoming tracks.</p><ol id="queue-list"></ol><small>Shows up to 10 upcoming items from this app's queue. Adding does not start playback. Music Assistant keeps the queue; this page never selects another player.</small></section></div>
<script>
'use strict';
const el=id=>document.getElementById(id),transport=[...document.querySelectorAll('[data-action]')];
let authRequired=true;let key='',connected=false,busy=false,connecting=false,timer=null,page=null,parentPage=null;
function say(text,error=false){el('message').textContent=text;el('message').classList.toggle('error',error);}
function setControls(){transport.forEach(b=>b.disabled=!connected||busy);document.querySelectorAll('#columns button').forEach(b=>b.disabled=!connected||busy);el('disconnect').disabled=!connected;el('connect').disabled=connecting;el('connect').textContent=connecting?'Connecting…':'Connect';if(page){el('queue-page').disabled=!connected||busy||!page.items.some(i=>i.type==='track'&&i.available);el('previous-page').disabled=!connected||busy||page.offset===0;el('next-page').disabled=!connected||busy||!page.has_more;}}
function disconnect(){clearTimeout(timer);timer=null;key='';connected=false;page=null;parentPage=null;el('key').value='';el('pair').hidden=false;el('columns').hidden=true;el('track').textContent='Connect to see playback';el('state').textContent='No connection';el('connection').textContent='Not connected';el('library-list').replaceChildren();el('queue-list').replaceChildren();setControls();}
class ApiError extends Error{constructor(message,status=0){super(message);this.status=status;}}
async function request(path,body){const abort=new AbortController(),timeout=setTimeout(()=>abort.abort(),4500);try{const response=await fetch(path,{method:body===undefined?'GET':'POST',headers:{...(authRequired?{Authorization:'Bearer '+key}:{}),...(body===undefined?{}:{'Content-Type':'application/json'})},body:body===undefined?undefined:JSON.stringify(body),cache:'no-store',signal:abort.signal});let data;try{data=await response.json();}catch(e){throw new ApiError('Kinegra Amp returned an unreadable response. Reload this page.',response.status);}if(!response.ok)throw new ApiError(response.status===401?'Access key rejected. Kinegra Amp may have restarted. Open Settings → Web remote for the current key.':data.error||'Request unavailable',response.status);return data;}catch(e){if(e.name==='AbortError')throw new ApiError('Connection timed out. Check that Kinegra Amp is open and Web remote is on.');if(e instanceof ApiError)throw e;throw new ApiError('Cannot reach Kinegra Amp. Check its address, Wi-Fi/LAN connection and Web remote setting.');}finally{clearTimeout(timeout);}}
function showError(error){say(error.message,true);if(!connected||error.status===401){el('pair-error').textContent=error.message;el('pair').hidden=false;}if(error.status===401){key='';connected=false;el('connection').textContent='Access key rejected';el('columns').hidden=true;clearTimeout(timer);}setControls();}
async function refresh(force=false){clearTimeout(timer);if((authRequired&&!key)||(!force&&document.hidden))return;try{const s=await request('/api/status');el('track').textContent=s.title||'No track selected';el('state').textContent=s.source+' · '+s.state+(s.detail?' · '+s.detail:'');el('connection').textContent='Connected to Kinegra Amp';connected=true;setControls();await refreshOffline();}catch(e){el('connection').textContent='Connection needs attention';showError(e);}finally{if((key||!authRequired)&&!document.hidden)timer=setTimeout(()=>refresh(),2000);}}
async function connect(){if(connecting)return;const supplied=el('key').value.trim().toLowerCase();if(authRequired&&!/^[0-9a-f]{16}$/.test(supplied)){const e=new ApiError('Enter the 16-character access key shown in Kinegra Amp Settings.');showError(e);return;}key=supplied;connecting=true;connected=false;el('pair-error').textContent='';el('connection').textContent='Connecting…';say('Connecting to Kinegra Amp…');setControls();try{await refresh(true);if(!connected)return;el('key').value='';el('pair').hidden=true;el('columns').hidden=false;say('Connected. Choose music below, or press Play to resume your queue.');await browse('tracks','',0);}catch(e){showError(e);}finally{connecting=false;setControls();}}
const delay=ms=>new Promise(resolve=>setTimeout(resolve,ms));
function nonce(){const bytes=new Uint8Array(12);crypto.getRandomValues(bytes);return Array.from(bytes,b=>b.toString(16).padStart(2,'0')).join('');}
async function job(path,body){const started=await request(path,body),deadline=Date.now()+42000;while(Date.now()<deadline){const result=await request('/api/operations/'+started.operation);if(result.state==='error')throw new ApiError(result.message);if(result.state==='done')return result;await delay(350);}throw new ApiError('This request is taking too long. Check Queue before retrying; nothing will be sent again automatically.');}
function renderPage(value){page=value;el('search').value=page.search;el('library-title').textContent=(page.collection||page.kind)+' · '+(page.items.length?'items '+(page.offset+1)+'–'+(page.offset+page.items.length):'no results');el('collection-back').hidden=page.kind!=='playlist_items';document.querySelectorAll('[data-kind]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.kind===page.kind)));const list=el('library-list');list.replaceChildren();for(const item of page.items){const row=document.createElement('article'),title=document.createElement('h3'),detail=document.createElement('p'),buttons=document.createElement('div');title.textContent=item.title;detail.textContent=[item.artist,item.album].filter(Boolean).join(' · ');buttons.className='row';function button(label,action){const b=document.createElement('button');b.textContent=label;b.onclick=action;buttons.append(b);}if(item.type!=='track')button('Open',()=>{parentPage={kind:page.kind,search:page.search,offset:page.offset};perform('/api/library/open',{page_id:page.page_id,item:item.id});});if(item.type!=='track'||item.available){button('▶ Play',()=>perform('/api/library/play',{page_id:page.page_id,item:item.id,request_id:nonce()}));button('+ Add to Queue',()=>perform('/api/queue/add',{page_id:page.page_id,item:item.id,request_id:nonce()}));}else detail.textContent+=' · Unavailable';row.append(title,detail,buttons);list.append(row);}if(!page.items.length)list.textContent='No music found. Try another search or category.';setControls();}
function renderQueue(value){const list=el('queue-list');list.replaceChildren();for(const item of value.items){const li=document.createElement('li');li.textContent=item.title+(item.artist?' · '+item.artist:'');list.append(li);}el('queue-message').textContent=value.items.length?'Up to 10 upcoming tracks · '+value.items.length+' shown':'No upcoming tracks reported.';}
async function perform(path,body){if(busy||!connected)return;busy=true;setControls();say(path.includes('/queue/add')?'Adding to Queue…':path.includes('/play')?'Preparing playback…':'Loading…');try{const result=await job(path,body);if(result.page)renderPage(result.page);if(result.queue)renderQueue(result.queue);say(result.message);if(path==='/api/queue/add'||path==='/api/queue/add-page'||path==='/api/library/play'){try{const q=await job('/api/queue/refresh',{});renderQueue(q.queue);}catch(e){say(result.message+' Queue refresh unavailable; use Refresh Queue.',true);}}}catch(e){showError(e);}finally{busy=false;setControls();}}
async function browse(kind,search='',offset=0){return perform('/api/library',{kind,search,offset});}
function pageRequest(offset){if(!page)return;if(page.kind==='playlist_items')perform('/api/library/page',{page_id:page.page_id,offset,search:el('search').value});else browse(page.kind,el('search').value,offset);}
async function refreshOffline(){const s=await request('/api/offline-status');el('offline-message').textContent=s.message||(!s.configured?'Optional: configure a local-file source to save this queue.':'');el('save-offline').hidden=s.active;el('offline-limit-label').hidden=s.active||s.has_pending;el('save-offline').textContent=s.has_pending?'Resume Saving':'Save Queue Offline';el('discard-offline').hidden=s.active||!s.has_pending;el('cancel-offline').hidden=!s.active;el('play-offline').hidden=!s.has_saved;el('play-offline').textContent=s.active?'Play Saved So Far':'Play Saved Queue';}
async function offlineAction(action){try{const limit=el('offline-limit');const body=action==='save'&&!el('offline-limit-label').hidden&&limit.value?{action,limit:Number(limit.value)}:{action};await request('/api/offline-save',body);await refreshOffline();}catch(e){showError(e);}}
el('save-offline').onclick=()=>offlineAction('save');el('cancel-offline').onclick=()=>offlineAction('cancel');el('discard-offline').onclick=()=>offlineAction('discard');el('play-offline').onclick=()=>offlineAction('play');el('save-source').onclick=async()=>{try{await request('/api/offline-source',{origin:el('source-origin').value.trim(),key:el('source-key').value.trim()});el('source-key').value='';await refreshOffline();say('Local-file source saved. Choose Save Queue Offline.');}catch(e){showError(e);}};
el('connect').onclick=connect;el('key').onkeydown=e=>{if(e.key==='Enter'){e.preventDefault();connect();}};el('disconnect').onclick=()=>{disconnect();say('Disconnected from the web remote. TV playback is unchanged.');};
transport.forEach(button=>button.onclick=async()=>{if(busy||!connected)return;busy=true;setControls();try{await request('/api/control',{action:button.dataset.action});say('Command accepted. Waiting for playback status…');await refresh(true);}catch(e){showError(e);}finally{busy=false;setControls();}});
document.querySelectorAll('[data-kind]').forEach(button=>button.onclick=()=>{parentPage=null;browse(button.dataset.kind,el('search').value,0);});el('search-form').onsubmit=e=>{e.preventDefault();if(!page)browse('tracks',el('search').value,0);else pageRequest(0);};el('previous-page').onclick=()=>pageRequest(Math.max(0,page.offset-25));el('next-page').onclick=()=>pageRequest(page.offset+25);el('queue-page').onclick=()=>perform('/api/queue/add-page',{page_id:page.page_id,request_id:nonce()});el('refresh-queue').onclick=()=>perform('/api/queue/refresh',{});el('view-queue').onclick=()=>{el('queue').scrollIntoView({behavior:'smooth',block:'start'});perform('/api/queue/refresh',{});};el('collection-back').onclick=()=>{const previous=parentPage||{kind:'albums',search:'',offset:0};parentPage=null;browse(previous.kind,previous.search,previous.offset);};
document.addEventListener('visibilitychange',()=>{clearTimeout(timer);if(!document.hidden&&(key||!authRequired))refresh(true);});window.addEventListener('error',()=>{say('The web remote encountered an error. Reload this page and try again.',true);});setControls();
(async()=>{try{const response=await fetch('/api/access',{cache:'no-store'});const policy=await response.json();if(!response.ok)throw new Error(policy.error||'Access unavailable');authRequired=policy.require_key!==false;if(!authRequired){el('key').hidden=true;el('pair').querySelector('label').textContent='Trusted LAN access: no key is required.';await connect();}}catch(error){say(error.message,true);}})();
</script></html>"""
