extends SceneTree
var failures=[]
func check(ok,label):
    print("ADAPTIVE_"+("PASS_" if ok else "FAIL_")+label)
    if not ok:failures.append(label)
func _init():call_deferred("run")
func run():
    var p=load("res://scripts/AdaptiveVisuals.gd").new()
    check(p.level==2 and p.mode=="auto","default_full_auto")
    p.observe(1000,42,.15,{},-1,-1,50)
    check(p.level==2,"one_slow_sample_no_flicker")
    p.observe(2000,42,.15,{},-1,-1,50)
    check(p.level==1,"sustained_pressure_light")
    p.observe(3000,42,.15,{},-1,-1,50);p.observe(4000,42,.15,{},-1,-1,50)
    check(p.level==0,"continued_pressure_audio_first")
    for i in range(5,35):p.observe(i*1000,20,0,{},15,-1,50)
    check(p.level==0,"recovery_waits_30_seconds")
    p.observe(35000,20,0,{},15,-1,50)
    check(p.level==1,"recovery_one_step_only")
    p.set_mode("full",36000);p.observe(37000,90,.9,{},90,-1,50)
    check(p.level==2,"manual_full_respected")
    p.observe(38000,20,0,{},15,3,50)
    check(p.level==0,"thermal_override")
    p.observe(39000,20,0,{},15,2,50)
    check(p.level==0,"warm_reading_cannot_bounce_full_after_hot")
    for i in range(40,70):p.observe(i*1000,20,0,{},15,0,50)
    check(p.level==0,"manual_thermal_recovery_waits")
    p.observe(70000,20,0,{},15,0,50)
    check(p.level==2,"manual_full_restores_after_cool_interval")
    p=load("res://scripts/AdaptiveVisuals.gd").new()
    p.set_mode("auto",40000)
    var a={"active":true,"generation":1,"underruns":0,"rebuffers":0,"buffering":false,"queued_ms":600}
    p.observe(41000,20,0,a,15,-1,50);a.underruns=2;p.observe(42000,20,0,a,15,-1,50)
    check(p.level==2,"startup_skips_not_overload")
    p.observe(44000,20,0,a,15,-1,50);a.underruns=3;p.observe(45000,20,0,a,15,-1,50)
    check(p.level==0,"new_audio_skip_prioritizes_audio")
    p.set_mode("auto",46000);a.generation=2;a.underruns=5;p.observe(47000,20,0,a,15,-1,50)
    check(p.level==2,"generation_change_rebases_counters")
    p.set_mode("auto",48000);p.observe(49000,33.33,.7,{},10,-1,30);p.observe(50000,33.33,.7,{},10,-1,30)
    check(p.level==2,"normal_30hz_not_overload")
    check(not p.set_mode("invalid"),"unknown_mode_rejected")
    p.observe(51000,NAN,0)
    check(p.level==2,"invalid_metric_ignored")
    print("ADAPTIVE_FAILURES=",failures.size());quit(0 if failures.empty() else 1)
