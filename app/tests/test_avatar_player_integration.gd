extends SceneTree
var failures=[]
func check(ok,label):
    print("AV_INTEGRATION_"+("PASS_" if ok else "FAIL_")+label)
    if not ok: failures.append(label)
func _init(): call_deferred("run")
func run():
    var app=load("res://Main.tscn").instance()
    get_root().add_child(app)
    yield(create_timer(0.5),"timeout")
    app.pose_visual.set_mode("demo")
    check(app.avatar_visual.active and not app.pose_visual.draw_skeleton,"original_avatar_default")
    app.pose_visual._process(0.1)
    app._process(0.1)
    check(not app.avatar_visual.last_points.empty(),"demo_drives_avatar")
    app.music_ui._cycle_avatar()
    check(app.avatar_visual.mode=="sunset" and app.avatar_visual.active,"next_style")
    app.music_ui._cycle_avatar()
    check(app.avatar_visual.mode=="ice","third_style")
    app.music_ui._cycle_avatar()
    check(app.avatar_visual.mode=="starlight" and app.avatar_visual.costume_parts["starlight"][0].visible,"starlight_costume")
    app.music_ui._cycle_avatar()
    check(app.avatar_visual.mode=="synth" and app.avatar_visual.costume_parts["synth"][0].visible and not app.avatar_visual.costume_parts["starlight"][0].visible,"synth_costume")
    app.music_ui._cycle_avatar()
    check(not app.avatar_visual.active and app.pose_visual.draw_skeleton,"skeleton_optional")
    app.music_ui._cycle_avatar()
    check(app.avatar_visual.active and app.avatar_visual.mode=="neon" and not app.pose_visual.draw_skeleton,"avatar_restored")
    app.backing_dancers.pressed=true
    app._process(0.1)
    check(app.backing_avatars.size()==2 and app.backing_avatars[0].active and app.backing_avatars[1].active and app.backing_avatars[0].last_points.empty() and app.backing_avatars[1].last_points.empty(),"backing_dancers_wait_for_real_audio")
    check(app.backing_avatars[0].mode!=app.avatar_visual.mode and app.backing_avatars[1].mode!=app.avatar_visual.mode and app.backing_avatars[0].mode!=app.backing_avatars[1].mode,"backing_cast_is_distinct")
    app.music_ui._enter_fullscreen()
    check(app.avatar_visual.fullscreen_visual and app.backing_avatars[0].fullscreen_visual,"avatar_fullscreen")
    app.music_ui._exit_fullscreen()
    check(not app.avatar_visual.fullscreen_visual and not app.backing_avatars[0].fullscreen_visual,"avatar_returns")
    app.backing_dancers.pressed=false
    check(not app.backing_avatars[0].active and not app.avatar_visual.grouped,"backing_dancers_can_be_disabled")
    print("AV_INTEGRATION_FAILURES=",failures.size())
    quit(0 if failures.empty() else 1)
