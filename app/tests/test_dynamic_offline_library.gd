extends SceneTree
var failures = 0
var checks = 0
const Music = preload("res://scripts/OfflineMusic.gd")
var prefix = "user://dynamic_offline_test_" + str(OS.get_ticks_msec())
func check(ok, name):
    checks += 1
    if not ok:
        failures += 1
        print("FAIL_DYNAMIC_LIBRARY ", name)
func _init():call_deferred("run")
func run():
    var playlist = preload("res://scripts/LocalPlaylists.gd").new()
    check(playlist.set_availability([true,true,true,true,true,false]), "expand_availability")
    check(playlist.indices() == [0,1,2,3,4], "all_includes_available_import")
    check(playlist.toggle_favorite(4) and playlist.is_favorite(4), "import_favourite")
    check(playlist.choose_playlist(3,4) == 4 and playlist.indices() == [4], "import_favourites_collection")
    playlist.set_availability([true,true,true,true,false,false])
    check(playlist.indices().empty() and playlist.is_favorite(4), "deletion_hides_but_preserves_favourite_identity")
    playlist.set_availability([true,true,true,true,true,false,true])
    check(playlist.indices() == [4] and not playlist.is_favorite(6), "restore_same_id_no_favourite_retarget")
    var store = preload("res://scripts/PlaylistStore.gd").new()
    var path = prefix + ".cfg"
    check(store.write(path, playlist.snapshot()), "v4_dynamic_preferences_saved")
    var saved = store.read(path)
    check(saved.ok and saved.state.favorites.size() == 7 and saved.state.favorites[4] and not saved.state.favorites[6], "v4_dynamic_preferences_roundtrip")
    var cfg = ConfigFile.new()
    cfg.load(path)
    check(cfg.get_value("omega","version") == 4, "writes_schema_four")
    for version in [1,2,3]:
        cfg.set_value("omega","version",version)
        cfg.set_value("omega","playlist",2)
        cfg.set_value("omega","repeat",1)
        cfg.set_value("omega","favorites",[0,1,0,1] if version == 1 else [false,true,false,true])
        cfg.set_value("omega","shuffle",version == 3)
        cfg.save(path)
        saved = store.read(path)
        check(saved.ok and saved.state.playlist == 2 and saved.state.repeat == 1 and saved.state.favorites == [false,true,false,true] and saved.state.shuffle == (version == 3), "legacy_exact_choices_"+str(version))
        var restored = preload("res://scripts/LocalPlaylists.gd").new()
        restored.set_availability([true,true,true,true,true])
        check(restored.restore(saved.state) and not restored.is_favorite(4), "legacy_expands_new_flags_false_"+str(version))
    cfg.set_value("omega","version",99)
    cfg.save(path)
    check(not store.write(path,playlist.snapshot()) and not store.read(path).ok,"future_preferences_not_overwritten")
    var queue = preload("res://scripts/QueueStore.gd").new()
    var queue_path = prefix + "_queue.cfg"
    check(queue.write(queue_path,[4,1027,0,4]) and queue.read(queue_path).items == [4,1027,0,4], "v2_stable_import_indices_roundtrip")
    cfg = ConfigFile.new()
    cfg.set_value("queue","version",1)
    cfg.set_value("queue","items",[3,0,3])
    cfg.save(queue_path)
    check(queue.read(queue_path).ok and queue.read(queue_path).items == [3,0,3], "legacy_queue_preserved")
    cfg.set_value("queue","items",[4])
    cfg.save(queue_path)
    check(not queue.read(queue_path).ok, "v1_never_accepts_import_alias")
    cfg.set_value("queue","version",99)
    cfg.save(queue_path)
    check(not queue.write(queue_path,[0]), "future_queue_not_overwritten")
    Directory.new().remove(queue_path)
    var music = Music.new()
    get_root().add_child(music)
    music.user_library.directory = prefix + "_audio"
    music.user_library.initialize()
    var input = load(Music.SOURCES[0]).data
    var digest = "d".repeat(64)
    var name = "import_"+digest+".ogg"
    var f = File.new()
    f.open(music.user_library.directory.plus_file(name),File.WRITE)
    f.store_buffer(input)
    f.close()
    f.open(music.user_library.directory.plus_file(name+".meta.json"),File.WRITE)
    f.store_string(to_json({"version":1,"file":name,"title":"Synthetic imported track","bytes":input.size(),"sha256":digest}))
    f.close()
    check(music.refresh_user_library() and music.track_count() == 5 and music.get_title(4) == "Synthetic imported track", "player_catalog_adopts_import")
    check(music.queue_track(4) and music.upcoming_queue == [4], "player_queues_import")
    check(music.select_track(4) and music.player.stream is AudioStreamOGGVorbis and music.current_title() == "Synthetic imported track", "player_plays_import")
    music.stop()
    check(music.remove_library_track(4) and not music.available(4) and music.track_count() == 5, "player_delete_tombstones_slot")
    check(music._play_queued() == 0 and music.upcoming_queue.empty(), "deleted_queue_item_skipped_without_retarget")
    music.queue_path = queue_path
    queue.write(queue_path,[9])
    check(not music.restore_queue() and music.queue_load_blocked and music.upcoming_queue.empty(), "unknown_queue_slot_blocked_not_future_alias")
    var dir = Directory.new()
    dir.open(music.user_library.directory)
    dir.list_dir_begin(true,true)
    var entry = dir.get_next()
    var entries = []
    while not entry.empty():
        entries.append(entry)
        entry = dir.get_next()
    dir.list_dir_end()
    for file in entries: dir.remove(file)
    Directory.new().remove(music.user_library.directory)
    Directory.new().remove(path)
    Directory.new().remove(queue_path)
    music.free()
    print("DYNAMIC_LIBRARY_CHECKS=",checks," FAILURES=",failures)
    quit(0 if failures == 0 else 1)
