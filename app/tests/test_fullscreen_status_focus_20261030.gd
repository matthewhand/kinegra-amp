extends SceneTree
var failures=[]
func check(ok,label):
    print("TV_STATUS_" + ("PASS_" if ok else "FAIL_") + label)
    if not ok: failures.append(label)
func _init(): call_deferred("run")
func run():
    var app=load("res://Main.tscn").instance()
    get_root().add_child(app)
    yield(create_timer(0.4),"timeout")
    var ui=app.music_ui
    ui._open_library()
    check((app.ma_panel.setup_box.visible and app.ma_panel.endpoint_edit.has_focus()) or (not app.ma_panel.setup_box.visible and app.ma_panel.setup_button.has_focus()),"library_opens_on_visible_focus_target")
    ui._close_open_catalog()
    ui._open_queue()
    check(ui.queue_drawer.visible,"queue_opens")
    ui._enter_fullscreen()
    check(not ui.queue_drawer.visible,"fullscreen_closes_queue")
    check(ui.fullscreen_playback.text.find("PAUSED") >= 0 or ui.fullscreen_playback.text.find("STOPPED") >= 0,"silent_offline_is_not_playing")
    app._play_offline_music()
    ui._process(0.21)
    check(ui.fullscreen_playback.text.begins_with("PLAYING") and ui.fullscreen_playback.text.find(" / ")>=0,"offline_playback_and_progress")
    app._stop_all_music()
    ui._process(0.21)
    check(ui.fullscreen_playback.text.find("PLAYING")<0,"stopped_offline_not_reported_as_playing")
    ui.show_ma_selection("Test title", "", "")
    ui._process(0.21)
    check(ui.fullscreen_track_title.text=="Test title", "selection_title")
    check(ui.fullscreen_track_artist.text.find("Artist not provided")>=0 and ui.fullscreen_album.text.find("Not provided")>=0,"missing_metadata_labelled")
    check(ui.fullscreen_art.texture==load("res://assets/branding/icon_192.png") and ui.fullscreen_art_caption.text=="BRAND ART","selection_does_not_reuse_local_art")
    check(ui.fullscreen_playback.text.find("SELECTION")>=0 and ui.fullscreen_playback.text.find("PLAYING")<0,"catalog_selection_never_claims_playing")
    check(ui.fullscreen_playback.text.find("00:00")<0,"catalog_selection_has_no_fabricated_progress")
    ui.source_label.text="MUSIC ASSISTANT  •  SHORT PREVIEW"
    ui._process(0.21)
    check(ui.fullscreen_playback.text.find("WAITING")>=0,"preview_without_audio_reports_waiting")
    for dimension in [Vector2(960,720), Vector2(1280,720), Vector2(1680,720)]:
        OS.window_size=dimension
        app.rect_size=get_root().size
        yield(create_timer(0.15),"timeout")
        app._set_large_text(true)
        yield(create_timer(0.05),"timeout")
        check(ui.fullscreen_track.rect_global_position.x>=0 and ui.fullscreen_track.rect_global_position.x+ui.fullscreen_track.rect_size.x<=dimension.x+2,"track_card_inside_"+str(dimension.x))
        check(ui.fullscreen_track.rect_global_position.y>=0 and ui.fullscreen_track.rect_global_position.y+ui.fullscreen_track.rect_size.y<=dimension.y+2,"track_card_vertical_inside_"+str(dimension.x))
        check(ui.fullscreen_playback.rect_global_position.y+ui.fullscreen_playback.rect_size.y<=ui.fullscreen_track.rect_global_position.y+ui.fullscreen_track.rect_size.y+2,"playback_inside_card_"+str(dimension.x))
        app._set_large_text(false)
    ui._exit_fullscreen()
    check(ui.fullscreen_button.has_focus(),"fullscreen_exit_restores_focus")
    ui._open_offline_collection()
    ui._enter_fullscreen()
    check(not ui.offline_drawer.visible,"fullscreen_closes_offline_library")
    ui._exit_fullscreen()
    app._stop_all_music()
    print("TV_STATUS_FAILURES=",failures)
    quit(0 if failures.empty() else 1)
