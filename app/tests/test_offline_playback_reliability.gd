extends SceneTree
# Local-only transport lifecycle. Uses four shipped Omega Oggs and an empty
# PCM buffer. No connected service, original preference edits or device I/O.
var checks = 0
var failures = []
func ck(value, label):
    checks += 1
    if not value:
        failures.append(label)
        printerr("FAIL ", label)
func _init():
    call_deferred("run")
func run():
    var app = load("res://Main.tscn").instance()
    get_root().add_child(app)
    yield(create_timer(0.20), "timeout")
    var music = app.offline_music
    ck(not music.is_playing() and not app.live_audio, "startup is silent")
    ck(app.music_ui.library_button.has_focus(), "initial remote focus is MA selection")
    ck(not music._advance_on_natural_finish, "natural completion disarmed at startup")
    music._on_finished()
    ck(not music.is_playing() and music.track_index == 0, "idle late completion never starts song")
    app._play_offline_music()
    yield(create_timer(0.06), "timeout")
    ck(music.is_playing() and app.live_audio, "explicit Play owns Ogg and FFT")
    ck(music._advance_on_natural_finish, "explicit Play arms natural completion")
    var initial = music.track_index
    music._on_finished() # Simulate delayed/incorrect completion from an older epoch.
    ck(music.track_index == initial and music.is_playing(), "late finished callback cannot skip active new song")
    app._stop_all_music()
    ck(not music.is_playing() and not app.live_audio, "Stop disarms Ogg and FFT")
    music._on_finished()
    ck(not music.is_playing() and music.track_index == initial, "late finished after Stop ignored")
    for i in range(4):
        app._play_offline_music()
        yield(create_timer(0.045), "timeout")
        ck(music.is_playing(), "rapid explicit Play accepted %d" % i)
        app._toggle_offline()
        ck(not music.is_playing() and music.player.stream_paused, "rapid Pause stays quiet %d" % i)
        music._on_finished()
        ck(not music.is_playing(), "paused finished callback cannot restart %d" % i)
        app._toggle_offline()
        ck(music.is_playing(), "explicit resume permitted %d" % i)
        app._stop_all_music()
        ck(not music._advance_on_natural_finish and music._pending_play_until_ms == 0, "rapid Stop synchronously revokes completion %d" % i)
        yield(create_timer(0.045), "timeout")
        ck(not music.is_playing(), "rapid Stop settles the audio engine silent %d" % i)
    ck(not music.seek_relative(5.0) and not music.is_playing(), "seek after Stop fails closed")
    app._play_offline_music()
    yield(create_timer(0.045), "timeout")
    ck(music.seek_relative(999999.0), "active seek allowed")
    ck(music.progress_seconds() < music.duration_seconds(), "seek clamps before EOF")
    music.stop()
    ck(not music.seek_relative(-10.0), "stopped player cannot seek")
    # Drive actual original-Ogg end-of-stream, not a fabricated callback.
    # Repeat OFF on the last track must leave the speaker stopped.
    music.playlists.set_shuffle(false, music.track_index)
    while music.playlists.repeat_name() != "OFF":
        music.playlists.cycle_repeat()
    ck(music.select_track(3), "original fourth Ogg selected explicitly")
    yield(create_timer(0.06), "timeout")
    var last_length = music.duration_seconds()
    ck(not music.player.stream.loop, "private playback stream is nonlooping")
    ck(load(music.SOURCES[3]).loop, "original cached Ogg keeps imported loop flag")
    ck(last_length > 10.0, "last original Ogg has real duration")
    music.player.seek(last_length - 0.12)
    yield(create_timer(0.70), "timeout")
    ck(not music.is_playing(), "actual last-Ogg finish obeys Repeat OFF")
    ck(music.track_index == 3 and not music._advance_on_natural_finish, "actual end does not restart track at Repeat OFF")
    # With Repeat ALL, the original last track must advance to track one.
    music.playlists.cycle_repeat()
    ck(music.playlists.repeat_name() == "ALL", "repeat cycles back to ALL")
    ck(music.play(), "explicit replay of original last Ogg")
    yield(create_timer(0.06), "timeout")
    music.player.seek(music.duration_seconds() - 0.12)
    yield(create_timer(0.70), "timeout")
    ck(music.track_index == 0 and music.is_playing(), "natural original-Ogg end advances under Repeat ALL")
    # Repeat ONE must restart the same song through the app, not asset loops.
    ck(music.playlists.cycle_repeat() == "ONE", "repeat one selected")
    music.player.seek(music.duration_seconds() - 0.12)
    yield(create_timer(0.70), "timeout")
    ck(music.track_index == 0 and music.is_playing(), "real original Ogg naturally repeats same song under ONE")
    ck(not music.player.stream.loop, "app controls repeat rather than imported asset looping")
    music.stop()
    music.playlists.cycle_repeat()
    ck(music.playlists.repeat_name() == "OFF", "repeat off selected for shuffled last-track check")
    music.playlists.cycle_repeat()
    ck(music.playlists.repeat_name() == "ALL", "repeat all restored")
    ck(music.playlists.set_shuffle_seed(23), "local deterministic shuffle seed accepted")
    ck(music.playlists.set_shuffle(true, music.track_index), "shuffle deck armed for real Ogg completion")
    var before_shuffle = music.track_index
    music.play()
    yield(create_timer(0.045), "timeout")
    ck(music.is_playing(), "explicit shuffled original-Ogg playback starts")
    yield(create_timer(0.05), "timeout")
    music.player.seek(music.duration_seconds() - 0.12)
    yield(create_timer(0.70), "timeout")
    ck(music.track_index != before_shuffle and music.is_playing(), "natural completion advances shuffled deck")
    ck(music.playlists._deck[music.playlists._deck_position] == music.track_index, "shuffle history position tracks actual completed audio")
    music.stop()
    # Local PCM must remain FFT owner if an unrelated, already-idle Ogg emits
    # a state_changed(false), including after earlier Play/Stop sequences.
    ck(app.begin_explicit_local_pcm(), "PCM route starts explicitly")
    ck(app.local_pcm.active and app.live_audio, "PCM owns audio after startup")
    music.stop()
    ck(app.local_pcm.active and app.live_audio, "idle Ogg Stop cannot revoke active PCM ownership")
    var pcm_epoch = app.analysis_epoch
    app._on_stream_active(false)
    ck(app.local_pcm.active and app.live_audio, "unrelated native/stream stop cannot revoke PCM FFT owner")
    ck(app.analysis_epoch == pcm_epoch, "unrelated stream stop cannot reset active PCM FFT epoch")
    app._process(0.02)
    ck(app.analysis_label.text == "LOCAL PCM / REAL AUDIO FFT", "local PCM remains displayed")
    ck(not music.is_playing(), "PCM ownership never starts original Ogg")
    app._notification(MainLoop.NOTIFICATION_WM_FOCUS_OUT)
    ck(not app.local_pcm.active and not app.live_audio, "focus loss disarms PCM")
    ck(app.analysis_owner == null, "focus loss clears analysis epoch")
    ck(not app.feed_explicit_local_pcm(PoolByteArray([0,0,0,0])), "post-focus old PCM rejected")
    ck(not music.is_playing() and not music._advance_on_natural_finish, "focus loss cannot arm audio")
    ck(music._pending_play_until_ms == 0, "focus loss cancels outstanding Play request")
    music._pending_play_until_ms = OS.get_ticks_msec() - 1
    music._process(0.02)
    ck(music._pending_play_until_ms == 0 and not music._advance_on_natural_finish, "expired Play request fails closed")
    ck(app.begin_explicit_local_pcm(), "PCM can explicitly restart after focus")
    app._handle_tv_back()
    ck(not app.local_pcm.active and not app.live_audio, "remote Back stops PCM rather than quitting")
    ck(app.music_ui.visible and app.music_ui.library_button.focus_mode == Control.FOCUS_ALL, "Back preserves TV stage navigation")
    ck(app.native_transport != null and not app.native_transport.active, "no live transport used")
    ck(app.ma_panel.catalog.token.empty(), "no Music Assistant credentials used")
    print("METHEXIS_PLAYBACK_RELIABILITY_CHECKS=",checks," FAILURES=",failures)
    quit(0 if failures.empty() else 1)
