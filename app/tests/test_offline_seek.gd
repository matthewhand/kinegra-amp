extends SceneTree
var checks = 0
var failures = []
func ck(ok, name):
    checks += 1
    if not ok:
        failures.append(name)
        printerr("FAIL ", name)
func _init():
    call_deferred("run")
func run():
    var app = load("res://Main.tscn").instance()
    get_root().add_child(app)
    yield(create_timer(0.2), "timeout")
    var music = app.offline_music
    var ui = app.music_ui
    ck(not music.is_playing(), "no startup autoplay")
    ck(ui.rewind_button != null and ui.forward_button != null, "both controls created")
    ck(ui.rewind_button.focus_mode == Control.FOCUS_ALL, "rewind supports D-pad")
    ck(ui.forward_button.focus_mode == Control.FOCUS_ALL, "forward supports D-pad")
    ck(ui.forward_button.focus_neighbour_left == ui.forward_button.get_path_to(ui.rewind_button), "forward D-pad left returns to rewind")
    ck(ui.rewind_button.rect_min_size.y >= 50, "large rewind target")
    ck(ui.forward_button.rect_min_size.y >= 50, "large forward target")
    ck(not app._seek_offline(10.0), "no seek before Play")
    ui.rewind_button.grab_focus()
    ui._seek_backward()
    ck(not music.is_playing(), "rewind never starts sound")
    ck(ui.rewind_button.has_focus(), "no focus theft on rejected seek")
    ck(not music.seek_relative("10"), "string rejected")
    ck(not music.seek_relative(NAN), "NaN rejected")
    ck(not music.seek_relative(INF), "infinity rejected")
    ck(not music.seek_relative(-INF), "negative infinity rejected")
    ck(not music.seek_relative(true), "boolean rejected")
    ck(not music.is_playing(), "bad seek cannot autoplay")
    app._play_offline_music()
    yield(create_timer(0.07), "timeout")
    ck(music.is_playing(), "user started Ogg")
    var length = music.duration_seconds()
    ck(length > 100.0, "original full track duration")
    ck(app._seek_offline(15.0), "valid forward seek")
    ck(music.progress_seconds() > 14.0, "clock advances")
    ck(music.is_playing(), "seek preserves playing")
    ck(music.seek_relative(999999.0), "large forward clamped")
    ck(music.progress_seconds() <= length - 0.35, "end margin held")
    ck(music.track_index == 0, "no track change")
    ck(music.seek_relative(-999999.0), "large rewind clamped")
    ck(music.progress_seconds() < 0.50, "start boundary held")
    ui.rewind_button.grab_focus()
    ui._seek_forward()
    ck(ui.rewind_button.has_focus(), "forward retains focus")
    ck(music.progress_seconds() > 9.0, "TV forward moves clock")
    ui._seek_backward()
    ck(music.progress_seconds() < 0.5, "TV rewind moves clock")
    var before_ma_seek = music.progress_seconds()
    ui.show_ma_selection("Source-only catalogue selection")
    ui._seek_forward()
    ck(music.progress_seconds() < before_ma_seek + 1.0, "MA-labelled seek cannot move offline audio")
    ck("OFFLINE MUSIC ONLY" in ui.status_label.text, "seek explains offline-only limit")
    ui.show_offline_track(music.current_title(), music.is_playing())
    music.toggle()
    ck(not music.is_playing(), "pause is silent")
    ck(music.player.stream_paused, "player paused")
    var paused_ok = music.seek_relative(17.0)
    ck(paused_ok and music.player.stream_paused, "seek preserves pause")
    ck(not music.is_playing(), "paused seek stays silent")
    ck(music.progress_seconds() > 16.0, "paused clock advanced")
    music.toggle()
    ck(music.is_playing(), "resume only on explicit Play")
    app._notification(MainLoop.NOTIFICATION_WM_FOCUS_OUT)
    ck(not music.is_playing(), "focus loss stops audio")
    ck(not app._seek_offline(10.0), "focus-out seek denied")
    ck(not music.is_playing(), "focus seek cannot resume")
    app._play_offline_music()
    yield(create_timer(0.08), "timeout")
    ck(music.is_playing(), "explicit playback can restart")
    app._stop_all_music()
    ck(not app._seek_offline(-10.0), "Stop revokes seek")
    print("METHEXIS_SEEK_CHECKS=", checks, " FAILURES=", failures)
    quit(0 if failures.empty() else 1)
