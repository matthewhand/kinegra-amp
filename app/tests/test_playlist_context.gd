extends SceneTree
var count=0
func check(value):
    count+=1
    if not value:push_error("Playlist context assertion failed")
func _init():
    var p=load("res://scripts/PlaylistContext.gd").new()
    check(p.remember("Night ride",["1","2"]))
    check(p.playlist("1")=="Night ride")
    check(p.playlist("3")=="")
    check(p.label("Real album","Night ride")=="ALBUM: Real album")
    check(p.label("","Night ride")=="PLAYLIST: Night ride")
    check(p.label("","")=="")
    check(not p.remember("Bad\nname",["3"]))
    check(not p.remember("Other",["library://track/3"]))
    check(p.playlist("3")=="")
    check(p.remember("Another playlist",["1"]))
    check(p.playlist("1")=="")
    check(p.playlist("2")=="Night ride")
    check(p.media_id({"provider":"library","item_id":"2"})=="2")
    check(p.media_id({"uri":"library://track/2"})=="2")
    check(p.media_id({"uri":"https://example.invalid/track/2"})=="")
    check(p.media_id({"uri":"library://track/2?token=not-a-token"})=="")
    p.clear()
    check(p.playlist("2")=="")
    var ui=load("res://scripts/MusicFirstUI.gd").new()
    ui.fullscreen_track_title=Label.new()
    ui.fullscreen_track_artist=Label.new()
    ui.fullscreen_album=Label.new()
    ui._set_fullscreen_track("Song","Artist","Music Assistant","Real album")
    check(ui.fullscreen_album.text=="ALBUM: Real album" and ui.fullscreen_album.visible)
    ui._set_fullscreen_track("Song","Artist","Music Assistant","","PLAYLIST: Night ride")
    check(ui.fullscreen_album.text=="PLAYLIST: Night ride" and ui.fullscreen_album.visible)
    ui._set_fullscreen_track("Unknown","Artist","Music Assistant")
    check(ui.fullscreen_album.text.empty() and not ui.fullscreen_album.visible)
    ui.fullscreen_track_title.free()
    ui.fullscreen_track_artist.free()
    ui.fullscreen_album.free()
    ui.free()
    print("PLAYLIST_CONTEXT checks=%d" % count)
    quit()
