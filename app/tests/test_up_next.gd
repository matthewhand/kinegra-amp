extends SceneTree
var failures=[]
func check(ok,label):
    print("QUEUE_"+("PASS_" if ok else "FAIL_")+label)
    if not ok: failures.append(label)
func _init(): call_deferred("run")
func run():
    var app=load("res://Main.tscn").instance()
    get_root().add_child(app)
    yield(create_timer(0.4),"timeout")
    var music=app.offline_music
    var ui=app.music_ui
    check(not music.is_playing(),"no_autoplay")
    ui._open_queue()
    check(ui.queue_drawer.visible and ui.queue_close_button.has_focus(),"empty_queue_focus")
    check(ui.queue_empty_label.visible and ui.queue_clear_button.disabled and ui.queue_remove_button.disabled,"empty_queue_guidance")
    app._handle_tv_back()
    check(not ui.queue_drawer.visible,"back_closes_queue")
    ui._open_offline_collection()
    ui._queue_add_2()
    ui._queue_add_1()
    check(music.upcoming_queue==[2,1] and not music.is_playing(),"add_without_playing")
    ui._open_queue()
    ui._queue_select_index(1)
    check(not ui.queue_empty_label.visible and not ui.queue_up_button.disabled and ui.queue_down_button.disabled,"queue_action_boundaries")
    ui._queue_up()
    check(music.upcoming_queue==[1,2],"reorder")
    ui._queue_remove()
    check(music.upcoming_queue==[2],"remove")
    ui._queue_add_3()
    ui._queue_down()
    check(music.upcoming_queue==[3,2],"move_down")
    check(music.next_track() and music.track_index==3 and music.upcoming_queue==[2],"next_consumes_queue")
    music.stop()
    music._on_finished()
    check(music.upcoming_queue==[2],"stop_does_not_advance")
    ui._queue_clear()
    check(music.upcoming_queue.empty(),"clear_queue")
    check(not music.queue_track(-1) and not music.queue_remove(0),"invalid_rejected")
    print("QUEUE_FAILURES=",failures.size())
    quit(0 if failures.empty() else 1)
