  "commands": [
    {
      "command": "music/playlists/get",
      "category": "Music",
      "summary": "Return (full) details for a single media item.",
      "description": "Return (full) details for a single media item.\n\nTries to find the item in the library first, falling back to\nfetching directly from the provider if not found.",
      "parameters": [
        {
          "name": "item_id",
          "type": "string",
          "required": true,
          "description": "The provider item id to fetch."
        },
        {
          "name": "provider_instance_id_or_domain",
          "type": "string",
          "required": true,
          "description": "The provider instance id or domain to fetch the item from."
        },
        {
          "name": "allow_update_metadata",
          "type": "boolean",
          "required": false,
          "description": "Schedule a metadata refresh on access. Set to False when fetching items in bulk (e.g. provider sync)."
        }
      ],
      "return_type": "Playlist",
      "authenticated": true,
      "required_scope": "library.read"
    },
    {
      "command": "music/playlists/library_items",
      "category": "Music",
      "summary": "Get the library items for this mediatype.",
      "description": "Get the library items for this mediatype.",
      "parameters": [
        {
          "name": "favorite",
          "type": "boolean",
          "required": false,
          "description": "Filter by favorite status."
        },
        {
          "name": "search",
          "type": "string",
          "required": false,
          "description": "Filter by search query."
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "description": "Maximum number of items to return."
        },
        {
          "name": "offset",
          "type": "integer",
          "required": false,
          "description": "Number of items to skip."
        },
        {
          "name": "order_by",
          "type": "string",
          "required": false,
          "description": "Order by field (e.g. 'sort_name', 'timestamp_added')."
        },
        {
          "name": "provider",
          "type": "string | Array of string",
          "required": false,
          "description": "Filter by provider instance ID (single string or list)."
        },
        {
          "name": "genre",
          "type": "integer | Array of integer",
          "required": false,
          "description": "Filter by genre id(s)."
        },
        {
          "name": "played_only",
          "type": "boolean",
          "required": false,
          "description": "Only include items that have been played (last_played > 0)."
        },
        {
          "name": "summary",
          "type": "boolean",
          "required": false,
          "description": "When True (default), return slim summary items containing only the fields needed for a list view. Set to False to get fully hydrated items."
        },
        {
          "name": "collapse_collections",
          "type": "boolean",
          "required": false,
          "description": "Collapse available collections. Items in a collection won't be returned individually."
        },
        {
          "name": "reachable_via",
          "type": "Array of string",
          "required": false,
          "description": "Restrict results to items with a provider mapping reachable through one of these provider instance ids (OR semantics), regardless of whether that mapping is itself in that provider's own library. This is independent of `provider`, which instead requires the *matched* mapping to be in-library. None applies no filter; an explicit empty list, or a list with no currently loaded/allowed instance, returns no items."
        },
        {
          "name": "kwargs",
          "type": "Any",
          "required": true,
          "description": ""
        },
        {
          "name": "user",
          "type": "string",
          "required": false,
          "description": "Optional user_id or username of the user to execute this command on behalf of. Requires the users.impersonate scope when targeting another user."
        }
      ],
      "return_type": "Array of ~ItemCls | Array of (~ItemCls | MediaCollection[~ItemCls])",
      "authenticated": true,
      "required_scope": "library.read"
    },
