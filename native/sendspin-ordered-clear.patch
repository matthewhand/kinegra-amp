 SyncTaskState SyncTask::handle_load_chunk(SyncContext& sync_context) {
+    // A clear marker may be decoded before the outer command flag is seen.
+    // A flushing sink resets priming at that boundary even if LOAD_CHUNK is
+    // still the selected state. Return through the regular priming path.
+    if (sync_context.initial_decode && this->player_impl_->listener != nullptr &&
+        this->player_impl_->listener->flushes_audio_on_stream_clear()) {
+        return SyncTaskState::INITIAL_SYNC;
+    }
     if (!this->player_impl_->client->is_time_synced()) {
         // Wait for the time filter to receive its first measurement before processing audio chunks.
         // Without a valid time offset, server timestamps can't be correctly converted to client
@@ -807,6 +815,20 @@
     if (sync_context.decode_buffer != nullptr) {
         sync_context.decode_buffer->decrease_buffer_length(sync_context.decode_buffer->available());
     }
+    // Flush application-side staging at the ordered sync-thread boundary.
+    if (this->player_impl_->listener != nullptr) {
+        this->player_impl_->listener->on_stream_clear();
+        if (this->player_impl_->listener->flushes_audio_on_stream_clear()) {
+            // The sink's ordered clear discarded every old output frame. None
+            // may remain on our predicted timeline or be reported as played.
+            // The clear callback returns only after the consumer acknowledged
+            // its new generation, before any post-clear write can occur.
+            this->playback_progress_slot_.reset();
+            sync_context.buffered_frames = 0;
+            sync_context.new_audio_client_playtime = 0;
+            sync_context.initial_decode = true;
+        }
+    }
     this->event_flags_.clear(EventGroupBits::COMMAND_STREAM_CLEAR);
 }

