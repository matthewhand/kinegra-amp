 // count, so it may refill the whole buffer before the sync task discards the audio queued ahead
 // of the boundary. The boundary releases that audio's charge at once, so the refill is kept, and
 // the sync task's later return of the old items releases nothing twice.
+TEST(PlayerInboundHandOff, ClearNotifiesSinkAtSyncBoundary) {
+    struct Sink : PlayerRoleListener {
+        int clears = 0;
+        size_t on_audio_write(uint8_t*, size_t length, uint32_t) override { return length; }
+        void on_stream_clear() override { ++clears; }
+    } sink;
+    auto impl = make_impl();
+    impl->listener = &sink;
+    impl->handle_stream_clear();
+    EXPECT_EQ(sink.clears, 0);
+    SyncContext context;
+    impl->sync_task->discard_to_clear_marker(context);
+    EXPECT_EQ(sink.clears, 1);
+    impl->listener = nullptr;
+}
+
+TEST(PlayerInboundHandOff, FlushingClearResetsOnlyDiscardedPlaybackAccounting) {
+    struct Sink : PlayerRoleListener {
+        bool flushes = false;
+        size_t on_audio_write(uint8_t*, size_t length, uint32_t) override { return length; }
+        bool flushes_audio_on_stream_clear() const override { return flushes; }
+    } sink;
+    auto impl = make_impl();
+    impl->listener = &sink;
+    SyncContext context;
+    context.buffered_frames = 4800;
+    context.new_audio_client_playtime = 123456;
+    context.initial_decode = false;
+    impl->sync_task->apply_stream_clear(context);
+    EXPECT_EQ(context.buffered_frames, 4800u);
+    EXPECT_EQ(context.new_audio_client_playtime, 123456);
+    EXPECT_FALSE(context.initial_decode);
+    sink.flushes = true;
+    impl->sync_task->notify_audio_played(512, 234567);
+    impl->sync_task->apply_stream_clear(context);
+    EXPECT_EQ(context.buffered_frames, 0u);
+    EXPECT_EQ(context.new_audio_client_playtime, 0);
+    EXPECT_TRUE(context.initial_decode);
+    PlaybackProgress discarded;
+    EXPECT_FALSE(impl->sync_task->playback_progress_slot_.take(discarded));
+    EXPECT_EQ(impl->sync_task->handle_load_chunk(context), SyncTaskState::INITIAL_SYNC);
+    impl->listener = nullptr;
+}
